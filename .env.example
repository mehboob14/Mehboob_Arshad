NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://postgres:postgres@localhost:5432/ggi_assessment

# Mocked OpenAI latency window (ms) - simulates real provider response time.
AI_LATENCY_MIN_MS=200
AI_LATENCY_MAX_MS=800

# Free messages granted to every user, per calendar month (UTC).
FREE_MESSAGES_PER_MONTH=3

# A PROCESSING idempotency claim older than this is considered abandoned
# (the owning process died) and may be taken over by a retry.
IDEMPOTENCY_CLAIM_TIMEOUT_MS=60000

# Fraction of simulated card charges that are declined (0 = never, 1 = always).
PAYMENT_FAILURE_RATE=0.2

# A charge claimed but never settled for this long is reported by the billing
# run as needing reconciliation, and is never retried automatically.
BILLING_STALE_PERIOD_MS=300000
